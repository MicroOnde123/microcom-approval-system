# Draft, cancellation, and returned-request workflow strings.
# Phase 1 stock safety.
# Approval interface: labels only; internal action values remain unchanged.
msgid "Approve"
msgstr "Approuver"

msgid "Reject"
msgstr "Rejeter"

msgid "Return for changes"
msgstr "Retourner pour correction"

msgid "Request approved successfully."
msgstr "Demande approuvée avec succès."

msgid "Request rejected successfully."
msgstr "Demande rejetée avec succès."

msgid "Request returned for changes."
msgstr "Demande retournée pour correction."

msgid "This approval is no longer active."
msgstr "Cette approbation n'est plus active."

msgid "Use at most two decimal places for the quantity."
msgstr "Utilisez au maximum deux décimales pour la quantité."

msgid "The quantity is too large."
msgstr "La quantité est trop élevée."

msgid "Enter a valid quantity."
msgstr "Saisissez une quantité valide."

msgid "You are not allowed to return stock."
msgstr "Vous n'êtes pas autorisé à retourner du matériel au stock."

msgid "Material returned to stock."
msgstr "Matériel retourné au stock."

msgid "Returned %(quantity)s %(unit)s of %(material)s to stock. Reason: %(reason)s"
msgstr "Retour au stock de %(quantity)s %(unit)s de %(material)s. Motif : %(reason)s"

msgid "Quantity must be greater than zero."
msgstr "La quantité doit être supérieure à zéro."

msgid "Stock has not been issued for this approved request."
msgstr "Le stock n'a pas été sorti pour cette demande approuvée."

msgid "Returns are blocked because this request has repeated material lines. Historical movements cannot be assigned safely."
msgstr "Les retours sont bloqués car cette demande contient plusieurs lignes du même matériel. Les mouvements historiques ne peuvent pas être attribués de manière fiable."

msgid "Stock movement history is inconsistent. A stock administrator must review it before a return."
msgstr "L'historique des mouvements de stock est incohérent. Un administrateur du stock doit le vérifier avant tout retour."

msgid "This return form has expired or is invalid. Open a new return form."
msgstr "Ce formulaire de retour a expiré ou n'est pas valide. Ouvrez un nouveau formulaire de retour."

msgid "A return reason is required."
msgstr "Le motif du retour est obligatoire."

msgid "Only %(quantity)s %(unit)s remain available to return."
msgstr "Seuls %(quantity)s %(unit)s restent disponibles pour un retour."

msgid "Insufficient stock for %(material)s. Available: %(available)s %(unit)s, requested: %(quantity)s %(unit)s."
msgstr "Stock insuffisant pour %(material)s. Disponible : %(available)s %(unit)s, demandé : %(quantity)s %(unit)s."

msgid "Stock deducted after approval of request %(number)s."
msgstr "Stock déduit après l'approbation de la demande %(number)s."

msgid "This return has already been recorded."
msgstr "Ce retour a déjà été enregistré."

msgid "Originally Issued Quantity"
msgstr "Quantité initialement sortie"

msgid "Previously Returned Quantity"
msgstr "Quantité déjà retournée"

msgid "Remaining Returnable Quantity"
msgstr "Quantité restante pouvant être retournée"

msgid "Save as Draft"
msgstr "Enregistrer comme brouillon"

msgid "Save Draft"
msgstr "Enregistrer le brouillon"

msgid "Save Changes"
msgstr "Enregistrer les modifications"

msgid "Resubmit Request"
msgstr "Soumettre à nouveau la demande"

msgid "Cancel Request"
msgstr "Annuler la demande"

msgid "Draft"
msgstr "Brouillon"

msgid "Cancelled"
msgstr "Annulée"

msgid "What is a Draft?"
msgstr "Qu'est-ce qu'un brouillon ?"

msgid "A draft allows you to save your request and continue working on it later."
msgstr "Un brouillon vous permet d'enregistrer votre demande et de la compléter plus tard."

msgid "Draft requests:"
msgstr "Les brouillons :"

msgid "Are visible only to you."
msgstr "Sont visibles uniquement par vous."

msgid "Are not sent for approval."
msgstr "Ne sont pas envoyés pour approbation."

msgid "Do not notify approvers."
msgstr "N'envoient aucune notification aux approbateurs."

msgid "Do not reserve or issue material."
msgstr "Ne réservent ni ne distribuent de matériel."

msgid "Can be edited at any time."
msgstr "Peuvent être modifiés à tout moment."

msgid "Can later be submitted for approval."
msgstr "Peuvent être soumis ultérieurement pour approbation."

msgid "Use Draft when information is incomplete or you are still preparing the request."
msgstr "Utilisez un brouillon lorsque les informations ne sont pas encore complètes ou lorsque la demande est encore en préparation."

msgid "This request is currently saved as a Draft and has not been submitted for approval."
msgstr "Cette demande est actuellement enregistrée comme brouillon et n'a pas encore été soumise pour approbation."

msgid "Are you sure you want to cancel this request? This action cannot be undone."
msgstr "Êtes-vous sûr de vouloir annuler cette demande ? Cette action est définitive."

msgid "Edit Draft Request"
msgstr "Modifier le brouillon"

msgid "Continue preparing this draft before submitting it for approval."
msgstr "Continuez à préparer ce brouillon avant de le soumettre pour approbation."

msgid "Edit Draft"
msgstr "Modifier le brouillon"

msgid "This request was already saved."
msgstr "Cette demande a déjà été enregistrée."

msgid "Draft saved successfully."
msgstr "Brouillon enregistré avec succès."

msgid "Changes saved successfully."
msgstr "Modifications enregistrées avec succès."

msgid "Request submitted successfully."
msgstr "Demande soumise avec succès."

msgid "Request updated and resubmitted successfully."
msgstr "Demande mise à jour et soumise à nouveau avec succès."

msgid "Duplicate material rows are not allowed."
msgstr "Les lignes de matériel en double ne sont pas autorisées."

msgid "At least one material is required for material requests."
msgstr "Au moins un matériel est requis pour les demandes de matériel."

msgid "No approval workflow is configured for this request type."
msgstr "Aucun circuit d'approbation n'est configuré pour ce type de demande."

msgid "Only draft or returned requests can be edited."
msgstr "Seuls les brouillons ou les demandes retournées peuvent être modifiés."

msgid "You are not allowed to cancel this request."
msgstr "Vous n'êtes pas autorisé à annuler cette demande."

msgid "This request cannot be cancelled."
msgstr "Cette demande ne peut pas etre annulee."

msgid "Request cancelled by user."
msgstr "Demande annulée par l'utilisateur."

msgid "Request cancelled successfully."
msgstr "Demande annulée avec succès."

